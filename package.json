    "predev": "node scripts/prepare-ort.mjs",
    "prebuild": "node scripts/prepare-ort.mjs",
    "pretypecheck": "node scripts/prepare-ort.mjs",
    "prelint": "node scripts/prepare-ort.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "dexie": "^4.4.7",
