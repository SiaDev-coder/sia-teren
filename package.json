{
  "name": "sia-teren",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SIA Teren — jurnal de șantier offline, cu transcriere vocală pe telefon",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
